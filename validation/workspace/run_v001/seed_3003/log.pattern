# =============================================================================
# in.pattern 模板（人类维护，Agent 只允许替换双下划线占位符，禁止改动物理内容）
# 渲染后每个 seed 目录中的 in.pattern 为独立、自包含的输入脚本。
# 路径铁律：脚本内只出现相对路径（../），禁止绝对路径与非 ASCII 字符。
# 单位制：metal (eV, Angstrom, ps, K)
# =============================================================================
units metal
atom_style atomic
boundary p p p

read_data ../structure.data
Reading data file ...
  orthogonal box = (0 0 -90) to (16.29 16.29 90)
  1 by 1 by 1 MPI processor grid
  reading atoms ...
  1856 atoms
  read_data CPU = 0.005 seconds
print "GEOM lx=$(lx) ly=$(ly) lz=$(lz) xlo=$(xlo) ylo=$(ylo) zlo=$(zlo)"
GEOM lx=16.289999999999999147 ly=16.289999999999999147 lz=180 xlo=0 ylo=0 zlo=-90

# --- 势函数：人类维护、哈希锁定；Agent 禁止编辑 -------------------------------
include ../potentials.in
# Validation potentials: Si many-body (Tersoff), Au many-body (EAM), Ti + all
# cross-layer terms via LJ.  Ti has no usable multi-element MEAM set locally.
pair_style hybrid tersoff eam lj/cut 10.0
pair_coeff * * tersoff "D:/LAMMPS/Tersoff/Si.tersoff" Si NULL NULL
Reading tersoff potential file D:/LAMMPS/Tersoff/Si.tersoff with DATE: 2007-10-25
pair_coeff 3 3 eam "D:/LAMMPS/Tersoff/Au_u3.eam"
Reading eam potential file D:/LAMMPS/Tersoff/Au_u3.eam with DATE: 2007-06-11
pair_coeff 1 2 lj/cut 0.050 2.50
pair_coeff 1 3 lj/cut 0.050 2.50
pair_coeff 2 2 lj/cut 0.300 2.55
pair_coeff 2 3 lj/cut 0.080 2.50
# -----------------------------------------------------------------------------

neighbor 2.0 bin
neigh_modify delay 0 every 1 check yes

# --- 热源 / 热汇区域：所有 z 坐标来自 geom.json，禁止写死 ----------------------
region hot_region  block INF INF INF INF -65.160000 -58.000000 units box
region cold_region block INF INF INF INF 58.000000 65.160000 units box
group hot_g  region hot_region
72 atoms in group hot_g
group cold_g region cold_region
72 atoms in group cold_g
variable hot_n  equal count(hot_g)
variable cold_n equal count(cold_g)
print "COUNTS hot=${hot_n} cold=${cold_n}"
COUNTS hot=72 cold=72

# --- 结构最小化（强制配置，禁止 Agent 修改）-----------------------------------
min_style cg
min_modify dmax 0.05
minimize 1e-6 1e-8 10000 100000
