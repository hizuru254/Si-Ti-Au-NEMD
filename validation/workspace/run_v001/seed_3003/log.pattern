fix hot  hot_g  heat 72  0.005
fix cold cold_g heat ${cold_n} -0.005
fix cold cold_g heat 72 -0.005
fix prod all nve

thermo_style custom step temp pe ke etotal f_hot f_cold
print "PROD_BEGIN step=$(step)"
