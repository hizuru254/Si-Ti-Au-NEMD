unfix eq

# --- NEMD 生产段：时间清零，便于后处理对齐 ------------------------------------
reset_timestep 0

compute Tprof all chunk/atom bin/1d z lower 2 units box
fix prof all ave/chunk 10 100 1000 Tprof temp file profile.txt

fix hot  hot_g  heat ${hot_n}  1
fix hot  hot_g  heat 1728  1
fix cold cold_g heat ${cold_n} -1
fix cold cold_g heat 1728 -1
fix prod all nve

thermo_style custom step temp pe ke etotal f_hot f_cold
print "PROD_BEGIN step=$(step)"
PROD_BEGIN step=0
run 2500
