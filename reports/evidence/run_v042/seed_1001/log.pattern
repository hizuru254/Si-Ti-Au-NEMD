LAMMPS (29 Sep 2021 - Update 2)
  using 1 OpenMP thread(s) per MPI task
# =============================================================================
# in.pattern 模板（人类维护，Agent 只允许替换双下划线占位符，禁止改动物理内容）
# 渲染后每个 seed 目录中的 in.pattern 为独立、自包含的输入脚本。
# 路径铁律：脚本内只出现相对路径（../），禁止绝对路径与非 ASCII 字符。
# 单位制：metal (eV, Angstrom, ps, K)
# =============================================================================
units metal
atom_style atomic
boundary p p p

read_data ../structure.data
Reading data file ...
  orthogonal box = (0.0000000 0.0000000 -115.00000) to (65.160000 65.160000 115.00000)
  2 by 2 by 6 MPI processor grid
  reading atoms ...
  45880 atoms
  read_data CPU = 0.034 seconds
print "GEOM lx=$(lx) ly=$(ly) lz=$(lz) xlo=$(xlo) ylo=$(ylo) zlo=$(zlo)"
GEOM lx=65.159999999999996589 ly=65.159999999999996589 lz=230 xlo=0 ylo=0 zlo=-115

# --- 势函数：人类维护、哈希锁定；Agent 禁止编辑 -------------------------------
include ../potentials.in
# Anchor potentials (strong interface variant): Si Tersoff, Au EAM, Ti hcp+LJ.
# Si-Ti / Ti-Au cross terms strengthened to mimic adhesion; still LJ, not silicide.
pair_style hybrid tersoff eam lj/cut 10.0
pair_coeff * * tersoff "/home/cc/si_nemd/potentials/Si.tersoff" Si NULL NULL
Reading tersoff potential file /home/cc/si_nemd/potentials/Si.tersoff with DATE: 2007-10-25
pair_coeff 3 3 eam "/home/cc/si_nemd/potentials/Au_u3.eam"
Reading eam potential file /home/cc/si_nemd/potentials/Au_u3.eam with DATE: 2007-06-11
pair_coeff 1 2 lj/cut 0.30 2.0
pair_coeff 1 3 lj/cut 0.20 2.0
pair_coeff 2 2 lj/cut 0.30 2.8
pair_coeff 2 3 lj/cut 0.20 2.0
# -----------------------------------------------------------------------------

neighbor 2.0 bin
neigh_modify delay 0 every 1 check yes

# --- 热源 / 热汇区域：所有 z 坐标来自 geom.json，禁止写死 ----------------------
region hot_region  block INF INF INF INF -92.000000 -84.000000 units box
region cold_region block INF INF INF INF 84.000000 92.000000 units box
group hot_g  region hot_region
1728 atoms in group hot_g
group cold_g region cold_region
1728 atoms in group cold_g
variable hot_n  equal count(hot_g)
variable cold_n equal count(cold_g)
print "COUNTS hot=${hot_n} cold=${cold_n}"
COUNTS hot=1728 cold=1728

# --- 结构最小化（强制配置，禁止 Agent 修改）-----------------------------------
min_style cg
min_modify dmax 0.05
minimize 1e-6 1e-8 10000 100000
Neighbor list info ...
  update every 1 steps, delay 0 steps, check yes
