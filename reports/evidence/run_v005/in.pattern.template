# =============================================================================
# in.pattern 模板（人类维护，Agent 只允许替换双下划线占位符，禁止改动物理内容）
# 渲染后每个 seed 目录中的 in.pattern 为独立、自包含的输入脚本。
# 路径铁律：脚本内只出现相对路径（../），禁止绝对路径与非 ASCII 字符。
# 单位制：metal (eV, Angstrom, ps, K)
# =============================================================================
units metal
atom_style atomic
boundary p p p

read_data __STRUCTURE__
print "GEOM lx=$(lx) ly=$(ly) lz=$(lz) xlo=$(xlo) ylo=$(ylo) zlo=$(zlo)"

# --- 势函数：人类维护、哈希锁定；Agent 禁止编辑 -------------------------------
include ../potentials.in
# -----------------------------------------------------------------------------

neighbor 2.0 bin
neigh_modify delay 0 every 1 check yes

# --- 热源 / 热汇区域：所有 z 坐标来自 geom.json，禁止写死 ----------------------
region hot_region  block INF INF INF INF __HOT_ZLO__ __HOT_ZHI__ units box
region cold_region block INF INF INF INF __COLD_ZLO__ __COLD_ZHI__ units box
group hot_g  region hot_region
group cold_g region cold_region
variable hot_n  equal count(hot_g)
variable cold_n equal count(cold_g)
print "COUNTS hot=${hot_n} cold=${cold_n}"

# --- 结构最小化（强制配置，禁止 Agent 修改）-----------------------------------
min_style cg
min_modify dmax 0.05
minimize 1e-6 1e-8 10000 100000

# --- 300 K 平衡（NVT）---------------------------------------------------------
velocity all create __T_EQ__ __SEED__ dist gaussian mom yes rot yes
fix eq all nvt temp __T_EQ__ __T_EQ__ 0.1
timestep __DT__
thermo __THERMO__
thermo_style custom step temp pe ke etotal
run __N_EQUIL__
unfix eq

# --- NEMD 生产段：时间清零，便于后处理对齐 ------------------------------------
reset_timestep 0

compute Tprof all chunk/atom bin/1d z lower __BIN__ units box
fix prof all ave/chunk __AVE_NEVERY__ __AVE_NREPEAT__ __AVE_NFREQ__ Tprof temp file profile.txt

fix hot  hot_g  heat ${hot_n}  __FLUX__
fix cold cold_g heat ${cold_n} -__FLUX__
fix prod all nve

thermo_style custom step temp pe ke etotal f_hot f_cold
print "PROD_BEGIN step=$(step)"
run __N_PROD__
print "PROD_END step=$(step)"

write_data final.data
